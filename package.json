{
  "name": "nulabg-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Bulgarian accounting platform nula.bg: invoices, bills, OCR, customers, inventory and banking for Claude and other MCP clients.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nula",
    "nula.bg",
    "accounting",
    "invoices",
    "bulgaria",
    "claude"
  ],
  "license": "MIT",
  "author": "Encorp (https://encorp.ai)",
  "homepage": "https://github.com/encorp-io/nulabg-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/encorp-io/nulabg-mcp.git"
  },
  "bugs": "https://github.com/encorp-io/nulabg-mcp/issues",
  "mcpName": "io.github.encorp-io/nulabg-mcp",
  "type": "module",
  "bin": {
    "nulabg-mcp": "dist/cli.js"
  },
  "main": "dist/server.js",
  "exports": {
    ".": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "dev": "node --watch --experimental-strip-types src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "capture": "node scripts/capture-shapes.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "inspect": "npx -y @modelcontextprotocol/inspector node dist/cli.js",
    "pack:mcpb": "node scripts/pack-mcpb.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "publishConfig": {
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@biomejs/biome": "^2.5.14",
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
